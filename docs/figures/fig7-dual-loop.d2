direction: right
vars: { d2-config: { layout-engine: elk } }

classes: {
  box: {
    style: {
      fill: "#ffffff"
      stroke: "#64748b"
      border-radius: 6
    }
  }
  key: {
    style: {
      fill: "#eef2ff"
      stroke: "#4f46e5"
      border-radius: 6
    }
  }
  grp: {
    style: {
      fill: "#f8fafc"
      stroke: "#cbd5e1"
      border-radius: 8
    }
  }
}

内环: "内环 · 一场赛事之内" {
  class: grp
  派发: "派发决策" {class: box}
  解题: "求解者解题" {class: box}
  事件: "结果与事件" {class: box}

  派发 -> 解题
  解题 -> 事件
  事件 -> 派发: "纳入经验" {style.stroke-dash: 4}
}

记录: "完整记录\n会话 · 事件 · 费用" {
  class: box
  width: 170
}
归因: "复盘归因\n卡在哪一步 · 为什么" {
  class: box
  width: 190
}
改进: "系统改进\n镜像 · 提示词 · 策略" {
  class: key
  width: 190
}

内环 -> 记录: "一场比赛打完"
记录 -> 归因
归因 -> 改进
改进 -> 内环: "成为下一场的起点" {style.stroke-dash: 4}
