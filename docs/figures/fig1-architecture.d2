direction: down
vars: { d2-config: { layout-engine: elk } }

classes: {
  box: {
    style: {
      fill: "#ffffff"
      stroke: "#64748b"
      border-radius: 6
    }
  }
  key: {
    style: {
      fill: "#eef2ff"
      stroke: "#4f46e5"
      border-radius: 6
    }
  }
  grp: {
    style: {
      fill: "#f8fafc"
      stroke: "#cbd5e1"
      border-radius: 8
    }
  }
}

赛事层: "赛事层" {
  class: grp
  调度者: "调度者 Agent ×1" {class: key}
}

题目层: "题目层" {
  class: grp
  A: "题目 A · 求解者 ×N" {class: box}
  B: "题目 B · 求解者 ×N" {class: box}
}

频道层: "频道层 · 协作全部经过频道" {
  class: grp
  g: "" {
    grid-rows: 1
    grid-columns: 4
    grid-gap: 8

    teamA: "#team · A" {class: box}
    teamB: "#team · B" {class: box}
    orch: "#orch" {class: box}
    dm: "DM" {class: box}
  }
}

赛事层 -> 题目层: "派出（模型 · 方向）"
题目层 -> 频道层: "写入事实 · 情报 · exp"
频道层 -> 赛事层: "汇报 · 系统事件" {style.stroke-dash: 4}
