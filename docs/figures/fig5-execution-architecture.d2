direction: right
vars: { d2-config: { layout-engine: elk } }

宿主: {
  agent: "Agent 循环 ×N（pi SDK）\n推理与决策，含调度者"
  server: "服务端\n编排 · 队列 · 记录"
  webui: "WebUI"

  server -> webui: "SSE 实时推送"
}

容器: "Kali 容器（按题目共享）" {
  tools: "离线 CTF 工具链"
  ws: "/workspace\nagents/<id>/ · shared/ · attachments/"
}

靶机: "靶机容器\n按需启动 · 闲置回收"

宿主.agent -> 容器.ws: "bash：docker exec"
容器 -> 宿主.server: "容器内 aegisx SDK → API\n题目同步 · flag 判定 · 靶机管理"
宿主.server -> 靶机
