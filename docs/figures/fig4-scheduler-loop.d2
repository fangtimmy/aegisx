direction: right
vars: { d2-config: { layout-engine: elk } }

classes: {
  box: {
    style: {
      fill: "#ffffff"
      stroke: "#64748b"
      border-radius: 6
    }
  }
  key: {
    style: {
      fill: "#eef2ff"
      stroke: "#4f46e5"
      border-radius: 6
    }
  }
}

输入: "实时状态\n+ #team 事实" {
  class: box
  width: 160
  height: 72
}
调度者: "调度者\n性价比评估" {
  class: key
  width: 160
  height: 72
}
队列: "任务队列\n排好序的计划" {
  class: box
  width: 170
  height: 72
}
执行: "执行\nFIFO 补位 · 槽位校验" {
  class: box
  width: 200
  height: 72
}
求解者: "求解者 ×N" {
  class: box
  width: 150
  height: 72
}
事件: "完成 · 超时 · 停滞\n新情报" {
  class: box
  width: 180
  height: 72
}
人: "人" {
  class: box
  width: 72
  height: 52
}

输入 -> 调度者
调度者 -> 队列: "产出计划"
队列 -> 执行: "持续推进\n调度者离线时仍在执行" {style.stroke-width: 3}
执行 -> 求解者
求解者 -> 事件
事件 -> 调度者: "回流"
人 -> 队列: "随时调整" {style.stroke-dash: 4}
