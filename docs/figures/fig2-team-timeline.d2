direction: down
vars: { d2-config: { layout-engine: elk } }

classes: {
  box: {
    style: {
      fill: "#ffffff"
      stroke: "#64748b"
      border-radius: 6
    }
  }
  grp: {
    style: {
      fill: "#f8fafc"
      stroke: "#cbd5e1"
      border-radius: 8
    }
  }
}

频道: "#team · 题目 A（时间 →）" {
  class: grp
  seq: "" {
    grid-rows: 1
    grid-columns: 4
    grid-gap: 8

    m1: "① 探测结果\n端口 8080 开放" {class: box}
    m2: "② 已证伪\n弱口令不存在" {class: box}
    m3: "③ exp 片段\n可复用脚本" {class: box}
    m4: "④ 已确认\n框架版本" {class: box}
  }
}

agents: "Agent 生命周期（依次接力）" {
  class: grp
  row: "" {
    grid-rows: 1
    grid-columns: 3
    grid-gap: 8

    a1: "Agent 1\n写入 ①②" {class: box}
    a2: "Agent 2\n读全部历史 · 写入 ③" {class: box}
    a3: "Agent 3\n读全部历史 · 写入 ④" {class: box}
  }
}

agents -> 频道: "事实持续追加"
频道 -> agents: "游标 0：每个新 Agent 首轮拉取全部历史" {style.stroke-dash: 4}
