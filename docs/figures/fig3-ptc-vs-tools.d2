direction: right
vars: { d2-config: { layout-engine: elk } }

classes: {
  box: {
    style: {
      fill: "#ffffff"
      stroke: "#64748b"
      border-radius: 6
    }
  }
  key: {
    style: {
      fill: "#eef2ff"
      stroke: "#4f46e5"
      border-radius: 6
    }
  }
  grp: {
    style: {
      fill: "#f8fafc"
      stroke: "#cbd5e1"
      border-radius: 8
    }
  }
}

对比: "" {
  style.stroke-width: 0
  style.fill: "#ffffff"
  grid-rows: 1
  grid-columns: 2
  grid-gap: 32

  原子工具: "原子工具 · N 个动作 = N 轮往返" {
    class: grp
    llm: "调度者 LLM" {
      class: box
      width: 150
      height: 64
    }
    t1: "启动 Agent" {class: box; width: 130; height: 48}
    t2: "停止 Agent" {class: box; width: 130; height: 48}
    t3: "查询状态" {class: box; width: 130; height: 48}
    t4: "调整队列" {class: box; width: 130; height: 48}

    llm <-> t1: "①"
    llm <-> t2: "②"
    llm <-> t3: "③"
    llm <-> t4: "④"
  }

  PTC: "PTC · 多步动作压缩为单次执行" {
    class: grp
    llm: "调度者 LLM" {
      class: box
      width: 150
      height: 64
    }
    script: "for c in snap.challenges:\n    if not c.solved_now and c.points >= 200:\n        queue.enqueue(c.id)" {
      class: key
      shape: code
      width: 420
    }
    sdk: "容器内平台 Python SDK" {class: box}
    api: "平台" {class: box}

    llm -> script: "一次执行"
    script -> sdk
    sdk -> api
    sdk -> llm: "结构化结果，一次返回" {style.stroke-dash: 4}
  }
}
