{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreDependencies": ["react-day-picker"],
  "ignoreBinaries": ["wait"],
  "workspaces": {
    "apps/server": {
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/components/ui/**"]
    },
    "apps/shared": {
      "project": ["*.ts"]
    }
  }
}
