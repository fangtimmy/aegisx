FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_INDEX_URL=https://mirrors.ustc.edu.cn/pypi/web/simple

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    sed -i "s@http://http.kali.org/kali@http://mirrors.ustc.edu.cn/kali@g" /etc/apt/sources.list.d/kali.sources && \
    apt-get update && \
    apt-get -y install --no-install-recommends nala && \
    nala install -y --no-install-recommends \
      kali-linux-headless \
      python3 python3-pip python3-venv \
      cargo rustc build-essential pkg-config \
      fonts-noto-cjk

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    nala install -y --no-install-recommends \
      bsdextrautils jq yq ripgrep fd-find iputils-ping sshpass ncat rlwrap \
      nmap sqlmap nikto dirsearch ffuf netcat-openbsd proxychains4 \
      chisel binwalk gdb file curl wget git tmux unzip && \
    ln -sf /usr/bin/fdfind /usr/local/bin/fd

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/tmp/cargo-target \
    CARGO_TARGET_DIR=/tmp/cargo-target \
    cargo install wsrx --locked --root /usr/local

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip3 install --break-system-packages \
      pwntools ropper capstone requests

RUN mkdir -p /workspace/knowledges && cd /workspace/knowledges && \
    git clone --depth=1 --single-branch https://github.com/swisskyrepo/PayloadsAllTheThings.git && \
    rm -rf */.git
    # git clone --depth=1 --single-branch https://github.com/HackTricks-wiki/hacktricks && \

WORKDIR /workspace

CMD ["sleep", "infinity"]
