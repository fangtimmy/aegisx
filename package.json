{
  "name": "aegisx",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run dev:server & bun run dev:web & wait",
    "dev:server": "bun run --filter @aegisx/server dev",
    "dev:web": "bun run --filter @aegisx/web dev",
    "check": "oxfmt --check package.json .oxfmtrc.json && knip && bun run --filter '@aegisx/*' check",
    "fmt": "oxfmt package.json .oxfmtrc.json && bun run --filter '@aegisx/*' fmt",
    "test": "bun run --filter '@aegisx/*' test",
    "test:sdk": "bun run --filter @aegisx/server test:sdk",
    "build": "bun run --filter @aegisx/web build",
    "db:generate": "bun run --filter @aegisx/server db:generate",
    "relay": "bun run --filter @aegisx/server relay"
  },
  "devDependencies": {
    "knip": "^6.32.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.76.0",
    "oxlint-tailwindcss": "^1.7.1",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "overrides": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "packageManager": "bun@1.4.0"
}
